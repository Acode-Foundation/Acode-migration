#!/bin/bash

usage() {
    echo "Usage: acode [file/folder...]"
    echo
    echo "Open files or folders in Acode editor."
    echo
    echo "Examples:"
    echo "  acode file.txt"
    echo "  acode ."
    echo "  acode ~/project"
    echo "  acode -h, --help"
}

get_abs_path() {
    local path="$1"
    local abs_path=""

    if command -v realpath >/dev/null 2>&1; then
        abs_path=$(realpath -- "$path" 2>/dev/null)
    fi

    if [ -z "$abs_path" ]; then
        if [ -d "$path" ]; then
            abs_path=$(cd -- "$path" 2>/dev/null && pwd -P)

        elif [ -e "$path" ]; then
            local dir_name
            local file_name

            dir_name=$(dirname -- "$path")
            file_name=$(basename -- "$path")

            abs_path="$(
                cd -- "$dir_name" 2>/dev/null &&
                pwd -P
            )/$file_name"

        elif [[ "$path" == /* ]]; then
            abs_path="$path"

        else
            abs_path="$PWD/$path"
        fi
    fi

    echo "$abs_path"
}

open_in_acode() {
    local path
    local type="file"

    path=$(get_abs_path "$1")

    if [ -d "$path" ]; then
        type="folder"
    fi

    printf '\e]7777;open;%s;%s\a' "$type" "$path"
}

if [ "$#" -eq 0 ]; then
    open_in_acode "."
    exit 0
fi

for arg in "$@"; do
    case "$arg" in
        -h|--help)
            usage
            exit 0
            ;;

        *)
            if [ -e "$arg" ]; then
                open_in_acode "$arg"
            else
                echo "Error: '$arg' does not exist" >&2
                exit 1
            fi
            ;;
    esac
done
